PORT=4000
JWT_SECRET=nocta-dev-secret-change-me
CLIENT_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
ADMIN_EMAIL=admin@nocta.app
ADMIN_PASSWORD=Admin1234!

# --- Mongo ---
# memory = embebido local. Atlas = mongodb+srv://...
# También podés usar MONGODB_USERNAME + MONGODB_PASSWORD si la URI no trae credenciales.
MONGODB_URI=memory
MONGODB_DB=nocta
MONGODB_USERNAME=
MONGODB_PASSWORD=
# Reintentos de conexión al arranque (backoff) antes de abortar
MONGODB_RETRIES=5
# true = seed automático si la DB remota está vacía
SEED_ON_EMPTY=true

# --- Mail (Nodemailer / Gmail App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=nocta.admin@gmail.com
SMTP_PASS=
MAIL_FROM=Nocta <nocta.admin@gmail.com>
# Destino de notificaciones internas; vacío = SMTP_USER
MAIL_NOTIFY_TO=
# false = no spamea la consola; true = loguea el HTML además de enviar
MAIL_DEV_LOG=false

# --- OAuth (vacío = 503 "no configurado") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM en una línea con \n
APPLE_PRIVATE_KEY=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
