PORT=4000
JWT_SECRET=nocta-dev-secret-change-me
CLIENT_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
ADMIN_EMAIL=admin@nocta.app
ADMIN_PASSWORD=Admin1234!

# --- Mongo ---
# memory = embebido local. Atlas = mongodb+srv://...
# También podés usar MONGODB_USERNAME + MONGODB_PASSWORD si la URI no trae credenciales.
MONGODB_URI=memory
MONGODB_DB=nocta
MONGODB_USERNAME=
MONGODB_PASSWORD=
# Reintentos de conexión al arranque (backoff) antes de abortar
MONGODB_RETRIES=5
# true = seed automático si la DB remota está vacía
SEED_ON_EMPTY=true

# --- Mail ---
# Transporte: auto | smtp | resend
# En Railway: preferí resend + dominio verificado (Gmail SMTP suele dar ETIMEDOUT).
MAIL_TRANSPORT=resend
# https://resend.com → API key + Domains (DNS verificado)
RESEND_API_KEY=
# Debe usar un from del dominio verificado en Resend (no Gmail).
# Ej.: Nocta <noreply@jpc-dev.uy>  o  Nocta <onboarding@resend.dev> (solo a tu mail)
MAIL_FROM=Nocta <noreply@jpc-dev.uy>
# SMTP solo local / si el host permite salida 587/465
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Destino de notificaciones internas; vacío = SMTP_USER o ADMIN_EMAIL
MAIL_NOTIFY_TO=
MAIL_DEV_LOG=false

# --- OAuth (vacío = 503 "no configurado") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM en una línea con \n
APPLE_PRIVATE_KEY=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# --- Mercado Pago (Premium PreApproval / suscripciones) ---
# Access Token de producción o TEST-… de sandbox
MP_ACCESS_TOKEN=
# Moneda de la suscripción PreApproval (default USD)
MP_CURRENCY=USD
# Opcional: secreto para validar firmas de webhook (si lo configurás en MP)
MP_WEBHOOK_SECRET=

# --- Railway Object Storage (Buckets) ---
# Crear un Bucket en el canvas de Railway y vincular variables al servicio API.
# Preset AWS SDK (recomendado) o referencias nativas del bucket.
# Driver: auto (Railway si hay credenciales; si no, memory) | railway | memory
STORAGE_DRIVER=auto
# Base pública CDN / custom domain delante del bucket (Fase 13).
# Producción/staging: obligatoria para servir sin firmas.
# Local: vacía → públicas salen como URL firmada al bucket (fallback OK).
# Nunca apuntar CDN a objetos private/ (identity/claims).
STORAGE_PUBLIC_BASE_URL=
# TTL default de URLs firmadas de lectura (segundos) — fallback sin CDN + privados
STORAGE_SIGNED_URL_TTL_SECONDS=3600
# Overrides opcionales (si no usás el preset AWS_* inyectado por Railway):
# STORAGE_ENDPOINT=
# STORAGE_REGION=auto
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_URL_STYLE=virtual
#
# Pipeline Sharp (Fase 2) — opcionales:
# IMAGE_SOCIAL_MAX_UPLOAD_BYTES=10485760
# IMAGE_WEBP_QUALITY=80
# IMAGE_AVIF_QUALITY=60
# IMAGE_VARIANT_THUMB_WIDTH=320
# IMAGE_VARIANT_MEDIUM_WIDTH=640
# IMAGE_VARIANT_LARGE_WIDTH=1080
#
# Fase 11: multipart staging = apps/api/tmp/upload-staging (no /uploads).
# /uploads queda solo lectura residual hasta cleanup confirmado.
#
# Fase 12 — jobs lifecycle (sin Redis):
# IMAGE_LIFECYCLE_JOBS=1
# IMAGE_LIFECYCLE_INTERVAL_MS=3600000
#
# Fase 14 — housekeeping: npm run diagnose:images (siempre dry-run).
# Métricas en logs: grepear [image-metric]
#
# Fase 15 — go-live:
# Producción exige Railway Object Storage (memory bloqueado).
# Emergencia local-like: STORAGE_ALLOW_MEMORY=1
# STORAGE_ALLOW_MEMORY=
# Obligatorio en prod: STORAGE_PUBLIC_BASE_URL + IMAGE_LIFECYCLE_JOBS=1 (o cron jobs:images)
#
# Variables típicas inyectadas por Railway (AWS SDK preset):
# AWS_ENDPOINT_URL=https://storage.railway.app  (o https://t3.storageapi.dev)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET_NAME=
# AWS_DEFAULT_REGION=auto
# AWS_S3_URL_STYLE=virtual
#
# O referencias nativas del bucket:
# ENDPOINT / ACCESS_KEY_ID / SECRET_ACCESS_KEY / BUCKET / REGION
