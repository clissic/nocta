PORT=4000
# "memory" = Mongo embebido (sin instalar nada). O: mongodb://127.0.0.1:27017/nocta
# Atlas: mongodb+srv://USER:PASS@cluster.../nocta
MONGODB_URI=memory
JWT_SECRET=nocta-dev-secret-change-me
CLIENT_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
ADMIN_EMAIL=admin@nocta.app
ADMIN_PASSWORD=admin123456

# --- OAuth (dejar vacío = 503 "no configurado" al iniciar login social) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM en una línea con \n: -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
APPLE_PRIVATE_KEY=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
