{
  "name": "@nocta/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "test": "tsx --test \"src/image-service/**/*.test.ts\" \"src/storage/**/*.test.ts\" \"src/image-lifecycle/**/*.test.ts\"",
    "test:e2e": "tsx --test src/e2e/images.e2e.test.ts",
    "test:all": "npm run test && npm run test:e2e",
    "validate:legacy-uploads": "tsx src/image-lifecycle/validateCli.ts",
    "migrate:images": "tsx src/image-lifecycle/migrateCli.ts",
    "cleanup:images": "tsx src/image-lifecycle/cleanupCli.ts",
    "validate:images": "tsx src/image-lifecycle/validateCli.ts",
    "repair:images-memory": "tsx src/image-lifecycle/repairMemoryMigrateCli.ts",
    "purge:deleted-accounts": "tsx src/image-lifecycle/purgeCli.ts",
    "diag:storage": "tsx src/image-lifecycle/storageDiagCli.ts",
    "diagnose:images": "tsx src/image-lifecycle/diagnoseCli.ts",
    "jobs:images": "tsx src/image-lifecycle/jobsCli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@aws-sdk/s3-request-presigner": "^3.1130.0",
    "@nocta/shared": "*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jose": "^6.2.8",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^3.6.1",
    "mongodb-memory-server": "^11.2.0",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "resend": "^6.27.0",
    "sharp": "^0.35.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
