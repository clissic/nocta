# Clave gratuita de CARTO Basemaps para las teselas raster.
# Solicitar una por proyecto/dominio: https://carto.com/basemaps/apikey/
VITE_CARTO_BASEMAPS_API_KEY=

# URL pública de la API (Railway). Vacío en local → proxy Vite `/api` y `/uploads`.
# Ejemplo: https://noctaapi-production.up.railway.app
VITE_API_URL=

# Site key pública de Cloudflare Turnstile. El secret va en apps/api/.env.
VITE_TURNSTILE_SITE_KEY=

# Sentry (Vite incrusta estas vars en el build). Vacío = no se inicializa.
# Después de setearlas en Railway hay que redesplegar la web.
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
