# Emulador Android → host machine (API en :4000)
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Dispositivo físico en la misma red Wi‑Fi (reemplazá por la IP de tu PC)
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# Misma clave CARTO Basemaps que en apps/web/.env.local (VITE_CARTO_BASEMAPS_API_KEY)
EXPO_PUBLIC_CARTO_BASEMAPS_API_KEY=

# Site key pública de Cloudflare Turnstile (la misma que VITE_TURNSTILE_SITE_KEY).
# El origen del widget en el teléfono es localhost hasta tener dominio público.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
# EXPO_PUBLIC_TURNSTILE_BASE_URL=http://localhost

# El project id de EAS vive en app.config.ts (extra.eas.projectId).
# No pongas un UUID inventado: Expo Go pide login y traba la terminal.
